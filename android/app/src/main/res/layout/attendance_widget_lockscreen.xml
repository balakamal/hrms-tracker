<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lockscreen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Compact Capsule Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_now_bar_capsule"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Status & Progress Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_widget_lockscreen_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Status"
                android:src="@drawable/ic_sparkle" />

            <TextView
                android:id="@+id/txt_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="IN-OFFICE"
                android:textColor="#0576F8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Work Duration Metric -->
        <TextView
            android:id="@+id/txt_widget_work_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="--h --m"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Est Exit Subtitle -->
        <TextView
            android:id="@+id/txt_widget_exit_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exit: --:--"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
