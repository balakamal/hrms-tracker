<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Today's Logged Hours Card -->
    <LinearLayout
        android:id="@+id/widget_hero_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_oneui_bg_pod"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon_timesheet"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Timesheet"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_timesheet"
                android:tint="#38BDF8" />

            <TextView
                android:id="@+id/widget_label_timesheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:singleLine="true"
                android:text="TODAY'S LOG"
                android:textColor="#38BDF8"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_work_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="8h 15m"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Ready for Submission"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Timesheet 1-Tap Action & Refresh Hub -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1-Tap Timesheet Launcher Pod -->
        <LinearLayout
            android:id="@+id/widget_btn_timesheet"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_oneui_bg_pod"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Open Timesheet"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_timesheet"
                android:tint="#38BDF8" />

            <TextView
                android:id="@+id/widget_btn_timesheet_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="TIMESHEET"
                android:textColor="#38BDF8"
                android:textSize="7.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Refresh Button -->
        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Refresh attendance stats"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

</LinearLayout>
