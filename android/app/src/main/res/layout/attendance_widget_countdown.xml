<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Primary Freedom Exit Countdown Card -->
    <LinearLayout
        android:id="@+id/widget_hero_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_oneui_bg_pod"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon_countdown"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Countdown Icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_timer"
                android:tint="#38BDF8" />

            <TextView
                android:id="@+id/widget_label_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:singleLine="true"
                android:text="FREEDOM O'CLOCK"
                android:textColor="#38BDF8"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Huge Glanceable Exit Time -->
        <TextView
            android:id="@+id/widget_exit_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="06:30 PM"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Remaining Time or Mood Status -->
        <TextView
            android:id="@+id/widget_progress_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="1h 45m left ⏳"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Side Status & Sync Pod -->
    <LinearLayout
        android:id="@+id/widget_cell_status"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/widget_oneui_bg_pod"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="80%"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:singleLine="true"
            android:text="IN THE ZONE"
            android:textColor="#94A3B8"
            android:textSize="7.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Refresh attendance stats"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

</LinearLayout>
