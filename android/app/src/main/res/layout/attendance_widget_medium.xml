<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_surface_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Left Pane: Work Time & Progress (No Borders) -->
    <LinearLayout
        android:id="@+id/widget_hero_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_m3_surface_tonal_dark"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_oneui_status_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="Live Beacon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_status_pulse_apple" />

            <TextView
                android:id="@+id/widget_work_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:singleLine="true"
                android:text="TIME AT DESK"
                android:textColor="#94A3B8"
                android:textSize="7.5sp"
                android:textStyle="bold" />

            <!-- Sleek WFH Pill for Medium Widget -->
            <LinearLayout
                android:id="@+id/widget_wfh_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_oneui_status_pill_wfh"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="WFH Active"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wfh_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="WFH"
                    android:textColor="#FBBF24"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_work_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="7h 24m"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Expressive Rounded Gradient Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="87"
            android:progressDrawable="@drawable/widget_progress_expressive" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp">

            <TextView
                android:id="@+id/widget_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="87%"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:singleLine="true"
                android:text="IN THE ZONE"
                android:textColor="#10B981"
                android:textSize="8sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Right Pane: Est. Exit & Frameless Refresh (No Borders) -->
    <LinearLayout
        android:id="@+id/widget_cell_exit"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@drawable/widget_m3_surface_tonal_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_label_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:singleLine="true"
            android:text="EST. EXIT"
            android:textColor="#94A3B8"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_exit_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="06:30 PM"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_progress_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="1h 06m left"
            android:textColor="#38BDF8"
            android:textSize="7.5sp" />

        <!-- Frameless Refresh FAB -->
        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Refresh attendance stats"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

</LinearLayout>
