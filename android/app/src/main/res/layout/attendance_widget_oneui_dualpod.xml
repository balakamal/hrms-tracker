<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_surface_dark"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- NORMAL OFFICE CONTENT: Apple Watch 250° Open-Bottom Dial + Hairline 3-Stat Telemetry -->
    <LinearLayout
        android:id="@+id/widget_normal_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Status Pill + Refresh Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_pill_phase_jade"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:singleLine="true"
                android:text="CLOCKED IN"
                android:textColor="#00E5A3"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/widget_btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_oneui_btn_refresh"
                android:contentDescription="Refresh attendance stats"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />
        </RelativeLayout>

        <!-- Center Open-Bottom Arc Instrument -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/img_gauge_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="Work Shift Arc Gauge"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="6dp">

                <TextView
                    android:id="@+id/widget_work_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="7h 24m"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_progress_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="1h 06m left"
                    android:textColor="#00E5A3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="87% goal"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Hairline Divider (No Nested Box Clutter) -->
        <View
            android:id="@+id/widget_hairline_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_hairline_dark" />

        <!-- 3-Column Hairline Telemetry Row: In | Break | Exit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_first_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_first_in_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="09:38 AM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/widget_hairline_v1"
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_hairline_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_break"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Break"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_break_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="0h 25m"
                    android:textColor="#FFB340"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/widget_hairline_v2"
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_hairline_dark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exit"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_exit_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="06:40 PM"
                    android:textColor="#00E5A3"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- DEDICATED CONTEXTUAL CONTAINER (NO IN YET / NOT LOGGED IN / WFH / WEEK OFF) -->
    <LinearLayout
        android:id="@+id/widget_context_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_context_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_pill_phase_slate"
                android:letterSpacing="0.05"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:text="NO IN YET"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/widget_btn_refresh_context"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_oneui_btn_refresh"
                android:contentDescription="Refresh attendance stats"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/img_context_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="6dp"
                android:contentDescription="Status Icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_status_pulse_apple" />

            <TextView
                android:id="@+id/widget_context_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Waiting for Punch"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_context_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="Tap refresh after punch"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_context_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_phase_slate"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_context_action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open HRMS ↗"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
