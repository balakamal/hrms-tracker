<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_surface_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- NORMAL OFFICE CONTENT CONTAINER -->
    <LinearLayout
        android:id="@+id/widget_normal_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Status Beacon & Label + Break Chip -->
        <LinearLayout
            android:id="@+id/widget_oneui_status_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_oneui_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Live Status Beacon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_status_pulse_apple" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="CLOCKED IN"
                    android:textColor="#00E5A3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Integrated Live Break Time Chip -->
                <LinearLayout
                    android:id="@+id/widget_break_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/widget_pill_phase_amber"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp">

                    <TextView
                        android:id="@+id/widget_break_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="☕ 0h 25m"
                        android:textColor="#FFB340"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Center: Primary Work Metric & 4-Phase Progress Track -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_work_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="5h 23m"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="63%"
                    android:textColor="#00E5A3"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4.5dp"
                android:layout_marginTop="2dp"
                android:max="100"
                android:progress="63"
                android:progressDrawable="@drawable/widget_progress_expressive" />
        </LinearLayout>

        <!-- Right: Exit Time & Frameless Refresh FAB -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_exit_time_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="06:05 PM"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_progress_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="3h 07m left"
                    android:textColor="#00E5A3"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_oneui_btn_refresh"
                android:contentDescription="Refresh attendance stats"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- DEDICATED CONTEXTUAL CONTAINER (WFH & WEEK OFF) -->
    <!-- Displayed when isWfh or isWeekOff is true: zero empty clock slots -->
    <LinearLayout
        android:id="@+id/widget_context_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_context_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Context Icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wfh_home" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_context_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Working From Home"
                android:textColor="#FFB340"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_context_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Turnstiles paused • Timesheet mode"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_context_action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_phase_amber"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Timesheet ↗"
            android:textColor="#FFB340"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_btn_refresh_context"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Refresh attendance stats"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

</LinearLayout>