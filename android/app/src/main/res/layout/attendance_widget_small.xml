<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_transparent"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Header: Mini Label, WFH Capsule & Refresh Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/widget_header_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="HRMS"
                android:textColor="#94A3B8"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <!-- Sleek WFH Pill for Small Widget -->
            <LinearLayout
                android:id="@+id/widget_wfh_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_oneui_status_pill_wfh"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/widget_wfh_icon"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="WFH Active"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wfh_home" />

                <TextView
                    android:id="@+id/widget_wfh_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="WFH"
                    android:textColor="#FBBF24"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Refresh attendance stats"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Main Content Pod: Interactive 1-Tap Carousel Card -->
    <LinearLayout
        android:id="@+id/widget_card_pod"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_oneui_bg_pod"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_metric_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:singleLine="true"
            android:text="TIME AT DESK"
            android:textColor="#94A3B8"
            android:textSize="7.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_work_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:singleLine="true"
            android:text="6h 45m"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Goal Met • 100%"
            android:textColor="#10B981"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="80"
            android:progressDrawable="@drawable/widget_oneui_progress_drawable" />
    </LinearLayout>

    <!-- Bottom Indicator Dots & Controls -->
    <RelativeLayout
        android:id="@+id/widget_footer_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Previous slide"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="Dot 1"
                android:src="@drawable/widget_dot_active" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="Dot 2"
                android:src="@drawable/widget_dot_inactive" />

            <ImageView
                android:id="@+id/dot_3"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="Dot 3"
                android:src="@drawable/widget_dot_inactive" />

            <ImageView
                android:id="@+id/dot_4"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:contentDescription="Dot 4"
                android:src="@drawable/widget_dot_inactive" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_oneui_btn_refresh"
            android:contentDescription="Next slide"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right" />
    </RelativeLayout>

</LinearLayout>
