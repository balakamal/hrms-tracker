<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_m3_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Mini Label, WFH Capsule & Refresh Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/widget_header_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="HRMS"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Sleek WFH Pill for Small Widget -->
            <LinearLayout
                android:id="@+id/widget_wfh_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_widget_wfh_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="WFH Active"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wfh_home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="WFH"
                    android:textColor="#FFCE20"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_m3_btn_refresh"
            android:contentDescription="Refresh attendance stats"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh" />
    </RelativeLayout>

    <!-- Main Content Pod: Interactive 1-Tap Carousel Card -->
    <LinearLayout
        android:id="@+id/widget_card_pod"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/widget_m3_pill_mint"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_metric_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="TIME AT DESK"
            android:textColor="#64748B"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_work_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="6h 45m"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Exit: 06:30 PM"
            android:textColor="#39B14A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Carousel Controls: Prev, Indicators & Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_carousel_btn"
            android:contentDescription="Previous Metric"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <!-- 4 Carousel Dots -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot_1"
                android:layout_width="14dp"
                android:layout_height="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Page 1"
                android:scaleType="centerInside"
                android:src="@drawable/widget_dot_active" />

            <ImageView
                android:id="@+id/dot_2"
                android:layout_width="14dp"
                android:layout_height="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Page 2"
                android:scaleType="centerInside"
                android:src="@drawable/widget_dot_inactive" />

            <ImageView
                android:id="@+id/dot_3"
                android:layout_width="14dp"
                android:layout_height="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Page 3"
                android:scaleType="centerInside"
                android:src="@drawable/widget_dot_inactive" />

            <ImageView
                android:id="@+id/dot_4"
                android:layout_width="14dp"
                android:layout_height="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="Page 4"
                android:scaleType="centerInside"
                android:src="@drawable/widget_dot_inactive" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/widget_carousel_btn"
            android:contentDescription="Next Metric"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Progress Capsule -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="80"
        android:progressDrawable="@drawable/widget_m3_progress_drawable" />

</LinearLayout>
