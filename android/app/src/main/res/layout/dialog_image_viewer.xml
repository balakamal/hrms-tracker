<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Interactive Hardware-Accelerated Zoomable Image View (Full Bleed Edge-to-Edge) -->
    <com.balakamal.hrmstracker.ZoomableImageView
        android:id="@+id/viewer_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Fullscreen Image" />

    <!-- Centered Loading Indicator -->
    <ProgressBar
        android:id="@+id/viewer_progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/accent_emerald"
        android:visibility="visible" />

    <!-- Error View -->
    <TextView
        android:id="@+id/viewer_error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="24dp"
        android:text="Failed to load image.\nPlease check network connection."
        android:textColor="@color/accent_rose"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <!-- Floating Top Bar with Frosted Glass Styling & Safe Insets -->
    <RelativeLayout
        android:id="@+id/viewer_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_top_bar_glass"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/viewer_btn_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_header_action_btn"
            android:contentDescription="Close viewer"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_white"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:id="@+id/viewer_title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/viewer_actions"
            android:layout_toEndOf="@+id/viewer_btn_close"
            android:orientation="vertical">

            <TextView
                android:id="@+id/viewer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="Image Preview"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/viewer_resolution_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Fetching original..."
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewer_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/viewer_btn_reset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_header_action_btn"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="1:1"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/viewer_btn_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_header_action_btn"
                android:contentDescription="Share image"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_share"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/viewer_btn_download"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_action_btn"
                android:contentDescription="Download full-resolution image"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download"
                app:tint="@color/text_primary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Controls & Pinch-to-zoom Hint -->
    <TextView
        android:id="@+id/viewer_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_now_bar_capsule"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="Pinch or double-tap to zoom • Drag to pan"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />

</RelativeLayout>
