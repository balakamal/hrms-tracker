<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme using MaterialComponents -->
    <style name="Theme.HRMS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#34D399</item>
        <item name="android:statusBarColor">#0F0F14</item>
        <item name="android:navigationBarColor">#0F0F14</item>
        <item name="android:windowBackground">#0F0F14</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#161822</item>
        
        <!-- Icon of the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        
        <!-- Theme to transition to after the splash screen finishes -->
        <item name="postSplashScreenTheme">@style/Theme.HRMS</item>
    </style>
</resources>
