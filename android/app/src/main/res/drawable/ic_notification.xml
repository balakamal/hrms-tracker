<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon for HRMS Tracker.
  Must be a flat, single-color (monochrome) drawable.
  Android renders only the alpha channel in the status bar — color values are ignored.
  Size: 24dp x 24dp (standard Material notification icon size).
  Shape: Clock outline with hands — represents time/attendance tracking.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Clock circle outline -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.99,2C6.47,2 2,6.48 2,12s4.47,10 9.99,10C17.52,22 22,17.52 22,12S17.52,2 11.99,2zM12,20c-4.42,0 -8,-3.58 -8,-8s3.58,-8 8,-8 8,3.58 8,8 -3.58,8 -8,8z" />
    <!-- Clock hands (hour hand pointing up-left, minute hand pointing right) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12.5,7H11v6l5.25,3.15 0.75,-1.23 -4.5,-2.67z" />
</vector>
