<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted obsidian glass gradient fading seamlessly down -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E60A0D14"
                android:centerColor="#990A0D14"
                android:endColor="#000A0D14" />
        </shape>
    </item>
    <!-- Hairline subtle separator -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
