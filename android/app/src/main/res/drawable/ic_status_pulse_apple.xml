<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Halo Glow (Apple Dynamic Island style) -->
    <item
        android:top="0dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="oval">
            <solid android:color="#3310B981" />
        </shape>
    </item>
    <!-- Crisp Bright Center Core -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <solid android:color="#10B981" />
        </shape>
    </item>
</layer-list>
