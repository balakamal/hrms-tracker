<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Track -->
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#041424" />
            <stroke
                android:width="0.8dp"
                android:color="#133863" />
        </shape>
    </item>
    <!-- Progress Fill -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="14dp" />
                <gradient
                    android:startColor="#0F47C0"
                    android:centerColor="#0576F8"
                    android:endColor="#39B14A"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
