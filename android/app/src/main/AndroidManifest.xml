<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_app_hrms"
        android:roundIcon="@mipmap/ic_app_hrms_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HRMS">
        
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_app_hrms"
            android:roundIcon="@mipmap/ic_app_hrms_round"
            android:enabled="true"
            android:exported="true"
            android:configChanges="orientation|screenSize"
            android:theme="@style/Theme.App.Starting" />

        <activity-alias
            android:name=".HrmsLauncherV2"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_app_hrms"
            android:roundIcon="@mipmap/ic_app_hrms_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Android Home Screen Widgets -->
        <receiver android:name=".AttendanceAppWidgetProvider"
            android:exported="true"
            android:label="HRMS Dashboard (Large)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.balakamal.hrmstracker.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info" />
        </receiver>

        <receiver android:name=".AttendanceAppWidgetProviderMedium"
            android:exported="true"
            android:label="HRMS Row (Medium)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.balakamal.hrmstracker.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info_medium" />
        </receiver>

        <receiver android:name=".AttendanceAppWidgetProviderSmall"
            android:exported="true"
            android:label="HRMS Badge (Small)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.balakamal.hrmstracker.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info_small" />
        </receiver>

        <receiver android:name=".WidgetCountdownProvider"
            android:exported="true"
            android:label="@string/widget_title_countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.balakamal.hrmstracker.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info_countdown" />
        </receiver>

        <receiver android:name=".WidgetTimesheetProvider"
            android:exported="true"
            android:label="@string/widget_title_timesheet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.balakamal.hrmstracker.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info_timesheet" />
        </receiver>

        <receiver android:name=".WidgetDialProvider"
            android:exported="true"
            android:label="@string/widget_title_dial">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.balakamal.hrmstracker.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/attendance_widget_info_dial" />
        </receiver>

        <activity
            android:name=".WidgetConfigureActivity"
            android:label="@string/title_widget_configure"
            android:exported="true"
            android:theme="@style/Theme.HRMS">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- FileProvider for secure image sharing and viewing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shift Alert Receiver for repeating leave office notifications -->
        <receiver
            android:name=".ShiftAlertReceiver"
            android:exported="false" />
    </application>
</manifest>
